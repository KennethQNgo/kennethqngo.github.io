<div class="col mb-4">
  <a href="{{ project.url | relative_url }}">
    <div class="card h-100 hoverable">
      <div class="row no-gutters">
        {% if project.img %}
          <div class="col-md-6">
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" class="card-img" %}
          </div>
        {% endif %}
        <div class="{% if project.img %}col-md-6{% else %}col-md-12{% endif %}">
          <div class="card-body">
            <h3 class="card-title">{{ project.title }}</h3>
            <p class="card-text">{{ project.description }}</p>
            {% if project.stack and project.stack.size > 0 %}
              <div class="project-stack-list">
                {% for item in project.stack %}
                  <span class="project-stack-chip">{{ item }}</span>
                {% endfor %}
              </div>
            {% endif %}
            {% if project.status %}
              <p class="project-status">{{ project.status }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
